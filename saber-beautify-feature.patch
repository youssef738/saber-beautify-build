+import 'package:flutter/material.dart';
+import 'package:google_fonts/google_fonts.dart';
+
+/// Catalog of fonts available for handwriting beautification.
+/// Arabic fonts support RTL text; Latin fonts support LTR text.
+class BeautifyFont {
+  const BeautifyFont(this.displayName, this.family, this.langCode);
+  final String displayName;
+  final String family;
+  final String langCode;
+
+  TextStyle style({double fontSize = 24, Color? color}) {
+    return switch (family) {
+      'Amiri' => GoogleFonts.amiri(fontSize: fontSize, color: color),
+      'Tajawal' => GoogleFonts.tajawal(fontSize: fontSize, color: color),
+      'Cairo' => GoogleFonts.cairo(fontSize: fontSize, color: color),
+      'ReemKufi' => GoogleFonts.reemKufi(fontSize: fontSize, color: color),
+      'Caveat' => GoogleFonts.caveat(fontSize: fontSize, color: color),
+      'PatrickHand' => GoogleFonts.patrickHand(fontSize: fontSize, color: color),
+      'ShadowsIntoLight' => GoogleFonts.shadowsIntoLight(fontSize: fontSize, color: color),
+      'PermanentMarker' => GoogleFonts.permanentMarker(fontSize: fontSize, color: color),
+      _ => TextStyle(fontFamily: family, fontSize: fontSize, color: color),
+    };
+  }
+}
+
+/// Static font catalogs and helpers for the beautification feature.
+class BeautifyFonts {
+  BeautifyFonts._();
+
+  static const arabic = [
+    BeautifyFont('Amiri', 'Amiri', 'ar'),
+    BeautifyFont('Tajawal', 'Tajawal', 'ar'),
+    BeautifyFont('Cairo', 'Cairo', 'ar'),
+    BeautifyFont('Reem Kufi', 'ReemKufi', 'ar'),
+  ];
+
+  static const latin = [
+    BeautifyFont('Caveat', 'Caveat', 'en'),
+    BeautifyFont('Patrick Hand', 'PatrickHand', 'en'),
+    BeautifyFont('Shadows Into Light', 'ShadowsIntoLight', 'en'),
+    BeautifyFont('Permanent Marker', 'PermanentMarker', 'en'),
+  ];
+
+  static List<BeautifyFont> forLanguage(String langCode) {
+    return langCode == 'ar' ? arabic : latin;
+  }
+}
diff --git a/lib/font_beautify/beautify_dialog.dart b/lib/font_beautify/beautify_dialog.dart
