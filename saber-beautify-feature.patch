diff --git a/lib/components/toolbar/handwriting_restyle_dialog.dart b/lib/components/toolbar/handwriting_restyle_dialog.dart
new file mode 100644
index 0000000..3f078c2
--- /dev/null
+++ b/lib/components/toolbar/handwriting_restyle_dialog.dart
@@ -0,0 +1,339 @@
+import 'dart:math' as math;
+import 'dart:typed_data';
+import 'dart:ui' as ui;
+
+import 'package:flutter/material.dart' hide Ink, Stroke;
+import 'package:google_mlkit_digital_ink_recognition/google_mlkit_digital_ink_recognition.dart'
+    as mlkit;
+import 'package:saber/components/canvas/_stroke.dart' as saber;
+
+/// A small, on-device-first recognition and restyling flow.
+///
+/// Recognition models are downloaded by ML Kit on demand. Ink is passed to the
+/// native Digital Ink API as stroke coordinates; it is not uploaded by this
+/// feature. Arabic and English are selectable per selection. Mixed-language
+/// selections should be split and processed separately for best recognition.
+class HandwritingBeautifyDialog extends StatefulWidget {
+  const HandwritingBeautifyDialog({
+    super.key,
+    required this.strokes,
+    required this.selectionBounds,
+    required this.inkColor,
+  });
+
+  final List<saber.Stroke> strokes;
+  final Rect selectionBounds;
+  final Color inkColor;
+
+  @override
+  State<HandwritingBeautifyDialog> createState() =>
+      _HandwritingBeautifyDialogState();
+}
+
+class _HandwritingBeautifyDialogState extends State<HandwritingBeautifyDialog> {
+  final _textController = TextEditingController();
+  String _languageCode = 'en-US';
+  String? _error;
+  bool _busy = false;
+  List<mlkit.RecognitionCandidate> _candidates = [];
+  int _candidateIndex = 0;
+
+  bool get _isArabic => _languageCode == 'ar';
+  String get _fontFamily => _isArabic ? 'ArefRuqaa' : 'Dekko';
+  TextDirection get _direction => _isArabic ? TextDirection.rtl : TextDirection.ltr;
+
+  @override
+  void dispose() {
+    _textController.dispose();
+    super.dispose();
+  }
+
+  Future<void> _recognize() async {
+    setState(() {
+      _busy = true;
+      _error = null;
+      _candidates = [];
+      _candidateIndex = 0;
+    });
+
+    final modelManager = mlkit.DigitalInkRecognizerModelManager();
+    mlkit.DigitalInkRecognizer? recognizer;
+    try {
+      final isDownloaded = await modelManager.isModelDownloaded(_languageCode);
+      if (!isDownloaded) {
+        final downloaded = await modelManager.downloadModel(
+          _languageCode,
+          isWifiRequired: false,
+        );
+        if (!downloaded) {
+          throw StateError('تعذّر تنزيل نموذج اللغة. / Could not download the language model.');
+        }
+      }
+
+      recognizer = mlkit.DigitalInkRecognizer(languageCode: _languageCode);
+      final ink = _toDigitalInk(widget.strokes, widget.selectionBounds);
+      final results = await recognizer.recognize(
+        ink,
+        context: mlkit.DigitalInkRecognitionContext(
+          writingArea: mlkit.WritingArea(
+            width: math.max(1.0, widget.selectionBounds.width).toDouble(),
+            height: math.max(1.0, widget.selectionBounds.height).toDouble(),
+          ),
+        ),
+      );
+      if (results.isEmpty) {
+        throw StateError('لم أتعرف على كلمات واضحة. جرّب تحديد سطر واحد والكتابة بوضوح أكبر. / No clear text was recognized. Try selecting one line and writing more clearly.');
+      }
+      if (!mounted) return;
+      setState(() {
+        _candidates = results;
+        _textController.text = results.first.text;
+      });
+    } catch (error) {
+      if (!mounted) return;
+      setState(() => _error = '$error');
+    } finally {
+      await recognizer?.close();
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  mlkit.Ink _toDigitalInk(List<saber.Stroke> strokes, Rect bounds) {
+    final inkStrokes = <mlkit.Stroke>[];
+    var timestamp = 0;
+    for (final source in strokes) {
+      if (source.points.isEmpty) continue;
+      final points = <mlkit.StrokePoint>[];
+      for (final point in source.points) {
+        // Saber stores x/y and pressure, but not the original time. Synthetic
+        // monotonic timestamps preserve stroke order for the recognizer.
+        timestamp += 12;
+        points.add(
+          mlkit.StrokePoint(
+            x: point.x - bounds.left,
+            y: point.y - bounds.top,
+            t: timestamp,
+          ),
+        );
+      }
+      if (points.isNotEmpty) {
+        inkStrokes.add(mlkit.Stroke()..points = points);
+      }
+      timestamp += 60;
+    }
+    return mlkit.Ink()..strokes = inkStrokes;
+  }
+
+  void _chooseCandidate(int index) {
+    setState(() {
+      _candidateIndex = index;
+      _textController.text = _candidates[index].text;
+      _textController.selection = TextSelection.collapsed(
+        offset: _textController.text.length,
+      );
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return AlertDialog(
+      title: const Text('تحسين الكتابة / Restyle handwriting'),
+      content: SizedBox(
+        width: 420,
+        child: SingleChildScrollView(
+          child: Column(
+            mainAxisSize: MainAxisSize.min,
+            crossAxisAlignment: CrossAxisAlignment.stretch,
+            children: [
+              const Text('اختَر لغة التعرّف لكل تحديد / Choose recognition language for this selection'),
+              const SizedBox(height: 8),
+              DropdownButton<String>(
+                value: _languageCode,
+                isExpanded: true,
+                items: const [
+                  DropdownMenuItem(value: 'ar', child: Text('العربية')),
+                  DropdownMenuItem(value: 'en-US', child: Text('English')),
+                ],
+                onChanged: _busy
+                    ? null
+                    : (value) {
+                        if (value == null) return;
+                        setState(() {
+                          _languageCode = value;
+                          _candidates = [];
+                          _error = null;
+                          _textController.clear();
+                        });
+                      },
+              ),
+              const SizedBox(height: 10),
+              FilledButton.icon(
+                onPressed: _busy ? null : _recognize,
+                icon: _busy
+                    ? const SizedBox.square(
+                        dimension: 18,
+                        child: CircularProgressIndicator(strokeWidth: 2),
+                      )
+                    : const Icon(Icons.document_scanner_outlined),
+                label: Text(_busy
+                    ? 'جارٍ التعرّف… / Recognizing…'
+                    : 'تعرّف على الكتابة / Recognize handwriting'),
+              ),
+              if (_error != null) ...[
+                const SizedBox(height: 10),
+                Text(_error!, style: TextStyle(color: Theme.of(context).colorScheme.error)),
+              ],
+              if (_candidates.length > 1) ...[
+                const SizedBox(height: 12),
+                const Text('اقتراحات التعرّف / Recognition alternatives'),
+                Wrap(
+                  spacing: 8,
+                  children: List.generate(_candidates.length.clamp(0, 4), (index) {
+                    return ChoiceChip(
+                      label: Text('${index + 1}'),
+                      selected: _candidateIndex == index,
+                      onSelected: (_) => _chooseCandidate(index),
+                    );
+                  }),
+                ),
+              ],
+              const SizedBox(height: 12),
+              TextField(
+                controller: _textController,
+                minLines: 1,
+                maxLines: 5,
+                textDirection: _direction,
+                decoration: const InputDecoration(
+                  labelText: 'النص بعد التعرّف (يمكن تصحيحه) / Recognized text (editable)',
+                  border: OutlineInputBorder(),
+                ),
+                onChanged: (_) => setState(() {}),
+              ),
+              if (_textController.text.isNotEmpty) ...[
+                const SizedBox(height: 12),
+                const Text('معاينة النمط / Style preview'),
+                const SizedBox(height: 4),
+                Container(
+                  constraints: const BoxConstraints(minHeight: 56, maxHeight: 120),
+                  alignment: _isArabic ? Alignment.centerRight : Alignment.centerLeft,
+                  padding: const EdgeInsets.all(8),
+                  decoration: BoxDecoration(
+                    border: Border.all(color: Theme.of(context).colorScheme.outlineVariant),
+                    borderRadius: BorderRadius.circular(8),
+                  ),
+                  child: Text(
+                    _textController.text,
+                    textDirection: _direction,
+                    style: TextStyle(
+                      fontFamily: _fontFamily,
+                      color: widget.inkColor,
+                      fontSize: 24,
+                    ),
+                  ),
+                ),
+              ],
+              const SizedBox(height: 8),
+              const Text(
+                'يعمل التعرّف على الجهاز بعد تنزيل نموذج اللغة. كل تحديد يُعالج بلغة واحدة؛ حدّد العربي والإنجليزي كلًّا على حدة.\nRecognition runs on-device after its language model is downloaded. Process Arabic and English selections separately.',
+                style: TextStyle(fontSize: 12),
+              ),
+            ],
+          ),
+        ),
+      ),
+      actions: [
+        TextButton(
+          onPressed: _busy ? null : () => Navigator.pop(context),
+          child: const Text('إلغاء / Cancel'),
+        ),
+        FilledButton(
+          onPressed: _textController.text.trim().isEmpty || _busy
+              ? null
+              : () => Navigator.pop(
+                    context,
+                    HandwritingBeautifyResult(
+                      text: _textController.text.trim(),
+                      languageCode: _languageCode,
+                      fontFamily: _fontFamily,
+                      textDirection: _direction,
+                    ),
+                  ),
+          child: const Text('استبدال التحديد / Replace selection'),
+        ),
+      ],
+    );
+  }
+}
+
+class HandwritingBeautifyResult {
+  const HandwritingBeautifyResult({
+    required this.text,
+    required this.languageCode,
+    required this.fontFamily,
+    required this.textDirection,
+  });
+
+  final String text;
+  final String languageCode;
+  final String fontFamily;
+  final TextDirection textDirection;
+}
+
+/// Renders a corrected transcript in a readable handwriting-style font.
+/// The result is a transparent PNG placed over the selected ink; original ink
+/// remains recoverable through Saber undo history.
+Future<Uint8List> renderBeautifiedTextPng({
+  required String text,
+  required String fontFamily,
+  required TextDirection textDirection,
+  required Color color,
+  required Size targetSize,
+}) async {
+  final width = math.max(24.0, targetSize.width).toDouble();
+  final height = math.max(24.0, targetSize.height).toDouble();
+  const pixelRatio = 3.0;
+  final imageWidth = (width * pixelRatio).ceil().clamp(1, 4096).toInt();
+  final imageHeight = (height * pixelRatio).ceil().clamp(1, 4096).toInt();
+
+  var fontSize = math.min(38.0, math.max(12.0, height * .72)).toDouble();
+  late final TextPainter painter;
+  while (true) {
+    final candidate = TextPainter(
+      text: TextSpan(
+        text: text,
+        style: TextStyle(
+          fontFamily: fontFamily,
+          fontSize: fontSize,
+          color: color,
+          height: 1.08,
+        ),
+      ),
+      textDirection: textDirection,
+      textAlign: textDirection == TextDirection.rtl ? TextAlign.right : TextAlign.left,
+    )..layout(maxWidth: math.max(8.0, width - 12).toDouble());
+    if ((candidate.height <= height - 6 && candidate.width <= width - 6) ||
+        fontSize <= 8) {
+      painter = candidate;
+      break;
+    }
+    fontSize -= 1;
+  }
+
+  final recorder = ui.PictureRecorder();
+  final canvas = ui.Canvas(recorder);
+  canvas.scale(pixelRatio);
+  painter.paint(
+    canvas,
+    Offset(
+      math.max(3.0, (width - painter.width) / 2).toDouble(),
+      math.max(3.0, (height - painter.height) / 2).toDouble(),
+    ),
+  );
+  final picture = recorder.endRecording();
+  final image = await picture.toImage(imageWidth, imageHeight);
+  final data = await image.toByteData(format: ui.ImageByteFormat.png);
+  image.dispose();
+  picture.dispose();
+  if (data == null) throw StateError('Could not render the restyled text.');
+  return data.buffer.asUint8List(data.offsetInBytes, data.lengthInBytes);
+}
